python criar_dataset.py
powershell -command "Write-Host '================ BLOCO 1: A1 - LMFCN (CENARIOS 1 A 5) ================'; 1..5 | ForEach-Object { $s =$_; Write-Host \"`n========================================\"; Write-Host \"      LMFCN - INICIANDO SETTING $s      \"; Write-Host \"========================================\"; $i = Get-Date; Write-Host 'INICIO:'$i.ToString('HH:mm:ss.ff'); python main_lmfcn.py --epoch 5 --relax 100 --lr 1.0 --feature 64 --svclose 5 --wrclose 5 --shclose 0 --width 275 --height 183 --outdir strawberry_out --outfile strawberry_$s --batch 32 -i setting$s-train.txt; $f = Get-Date; Write-Host 'FIM:   ' $f.ToString('HH:mm:ss.ff'); Write-Host 'TEMPO TOTAL LMFCN SETTING'$s ':' ([math]::Round(($f -$i).TotalSeconds, 2)) 'segundos'; Write-Host \"========================================`n\" }; Write-Host '================ BLOCO 2: B1 - YOLO11 SCRATCH (CENARIOS 1 A 5) ================'; 1..5 | ForEach-Object { $s =$_; Write-Host \"`n========================================\"; Write-Host \"   YOLO11 SCRATCH - INICIANDO SETTING $s \"; Write-Host \"========================================\"; $i = Get-Date; Write-Host 'INICIO:'$i.ToString('HH:mm:ss.ff'); python main_baselines.py --model yolo11 --pretrained 0 --epoch 5 --width 275 --height 183 --outdir strawberry_out --outfile strawberry_$s --batch 32 -i setting$s-train.txt; $f = Get-Date; Write-Host 'FIM:   ' $f.ToString('HH:mm:ss.ff'); Write-Host 'TEMPO TOTAL YOLO11 SCRATCH SETTING'$s ':' ([math]::Round(($f -$i).TotalSeconds, 2)) 'segundos'; Write-Host \"========================================`n\" }; Write-Host '================ BLOCO 3: B2 - YOLO11 PRE-TREINADO (CENARIOS 1 A 5) ================'; 1..5 | ForEach-Object { $s =$_; Write-Host \"`n========================================\"; Write-Host \" YOLO11 PRE-TREINADO - SETTING $s        \"; Write-Host \"========================================\"; $i = Get-Date; Write-Host 'INICIO:'$i.ToString('HH:mm:ss.ff'); python main_baselines.py --model yolo11 --pretrained 1 --epoch 5 --width 275 --height 183 --outdir strawberry_out --outfile strawberry_$s --batch 32 -i setting$s-train.txt; $f = Get-Date; Write-Host 'FIM:   ' $f.ToString('HH:mm:ss.ff'); Write-Host 'TEMPO TOTAL YOLO11 PRE-TREINADO SETTING'$s ':' ([math]::Round(($f -$i).TotalSeconds, 2)) 'segundos'; Write-Host \"========================================`n\" }; Write-Host '================ BLOCO 4: C1 - MOBILENET SCRATCH (CENARIOS 1 A 5) ================'; 1..5 | ForEach-Object { $s =$_; Write-Host \"`n========================================\"; Write-Host \"  MOBILENET SCRATCH - SETTING $s         \"; Write-Host \"========================================\"; $i = Get-Date; Write-Host 'INICIO:'$i.ToString('HH:mm:ss.ff'); python main_baselines.py --model mobilenet --pretrained 0 --epoch 5 --width 275 --height 183 --outdir strawberry_out --outfile strawberry_$s --batch 32 -i setting$s-train.txt; $f = Get-Date; Write-Host 'FIM:   ' $f.ToString('HH:mm:ss.ff'); Write-Host 'TEMPO TOTAL MOBILENET SCRATCH SETTING'$s ':' ([math]::Round(($f -$i).TotalSeconds, 2)) 'segundos'; Write-Host \"========================================`n\" }; Write-Host '================ BLOCO 5: C2 - MOBILENET PRE-TREINADO (CENARIOS 1 A 5) ================'; 1..5 | ForEach-Object { $s =$_; Write-Host \"`n========================================\"; Write-Host \" MOBILENET PRE-TREINADO - SETTING $s     \"; Write-Host \"========================================\"; $i = Get-Date; Write-Host 'INICIO:'$i.ToString('HH:mm:ss.ff'); python main_baselines.py --model mobilenet --pretrained 1 --epoch 5 --width 275 --height 183 --outdir strawberry_out --outfile strawberry_$s --batch 32 -i setting$s-train.txt; $f = Get-Date; Write-Host 'FIM:   ' $f.ToString('HH:mm:ss.ff'); Write-Host 'TEMPO TOTAL MOBILENET PRE-TREINADO SETTING'$s ':' ([math]::Round(($f -$i).TotalSeconds, 2)) 'segundos'; Write-Host \"========================================`n\" }"