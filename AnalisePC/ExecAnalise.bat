@echo off
chcp 65001 >nul
set PYTHONIOENCODING=utf-8

powershell -NoProfile -Command ^
  "$ts = Get-Date -Format 'yyyyMMdd_HHmmss'; " ^
  "$logFile = \"relatorio_$ts.txt\"; " ^
  "function Log($txt) { $txt | Tee-Object -FilePath $logFile -Append }; " ^
  "Log '================ PREPARACAO E AUDITORIA DO DATASET ================'; " ^
  "python -u criar_dataset.py | Tee-Object -FilePath $logFile -Append; " ^
  "if ($LASTEXITCODE -ne 0) { Write-Host '`n[ERRO] Falha no criar_dataset.py! Abortando execucao.' -ForegroundColor Red; exit $LASTEXITCODE }; " ^
  "Log \"`n================ BLOCO 1: A1 - LMFCN (CENARIOS 1 A 5) ================\"; " ^
  "1..5 | ForEach-Object { $s = $_; Log \"`n========================================\"; Log \"      LMFCN - INICIANDO SETTING $s      \"; Log \"========================================\"; $i = Get-Date; Log ('INICIO: ' + $i.ToString('HH:mm:ss.ff')); python -u main_lmfcn.py --epoch 5 --relax 100 --lr 1.0 --feature 64 --svclose 5 --wrclose 5 --shclose 0 --width 275 --height 183 --outdir strawberry_out --outfile strawberry_$s --batch 32 -i setting$s-train.txt | Tee-Object -FilePath $logFile -Append; $f = Get-Date; Log ('FIM:    ' + $f.ToString('HH:mm:ss.ff')); Log ('TEMPO TOTAL LMFCN SETTING ' + $s + ' : ' + [math]::Round(($f - $i).TotalSeconds, 2) + ' segundos'); Log \"========================================`n\" }; " ^
  "Log '================ BLOCO 2: B1 - YOLO11 SCRATCH (CENARIOS 1 A 5) ================'; " ^
  "1..5 | ForEach-Object { $s = $_; Log \"`n========================================\"; Log \"   YOLO11 SCRATCH - INICIANDO SETTING $s \"; Log \"========================================\"; $i = Get-Date; Log ('INICIO: ' + $i.ToString('HH:mm:ss.ff')); python -u main_baselines.py --model yolo11 --pretrained 0 --epoch 5 --width 275 --height 183 --outdir strawberry_out --outfile strawberry_$s --batch 32 -i setting$s-train.txt | Tee-Object -FilePath $logFile -Append; $f = Get-Date; Log ('FIM:    ' + $f.ToString('HH:mm:ss.ff')); Log ('TEMPO TOTAL YOLO11 SCRATCH SETTING ' + $s + ' : ' + [math]::Round(($f - $i).TotalSeconds, 2) + ' segundos'); Log \"========================================`n\" }; " ^
  "Log '================ BLOCO 3: B2 - YOLO11 PRE-TREINADO (CENARIOS 1 A 5) ================'; " ^
  "1..5 | ForEach-Object { $s = $_; Log \"`n========================================\"; Log \" YOLO11 PRE-TREINADO - SETTING $s        \"; Log \"========================================\"; $i = Get-Date; Log ('INICIO: ' + $i.ToString('HH:mm:ss.ff')); python -u main_baselines.py --model yolo11 --pretrained 1 --epoch 5 --width 275 --height 183 --outdir strawberry_out --outfile strawberry_$s --batch 32 -i setting$s-train.txt | Tee-Object -FilePath $logFile -Append; $f = Get-Date; Log ('FIM:    ' + $f.ToString('HH:mm:ss.ff')); Log ('TEMPO TOTAL YOLO11 PRE-TREINADO SETTING ' + $s + ' : ' + [math]::Round(($f - $i).TotalSeconds, 2) + ' segundos'); Log \"========================================`n\" }; " ^
  "Log '================ BLOCO 4: C1 - MOBILENET SCRATCH (CENARIOS 1 A 5) ================'; " ^
  "1..5 | ForEach-Object { $s = $_; Log \"`n========================================\"; Log \"  MOBILENET SCRATCH - SETTING $s         \"; Log \"========================================\"; $i = Get-Date; Log ('INICIO: ' + $i.ToString('HH:mm:ss.ff')); python -u main_baselines.py --model mobilenet --pretrained 0 --epoch 5 --width 275 --height 183 --outdir strawberry_out --outfile strawberry_$s --batch 32 -i setting$s-train.txt | Tee-Object -FilePath $logFile -Append; $f = Get-Date; Log ('FIM:    ' + $f.ToString('HH:mm:ss.ff')); Log ('TEMPO TOTAL MOBILENET SCRATCH SETTING ' + $s + ' : ' + [math]::Round(($f - $i).TotalSeconds, 2) + ' segundos'); Log \"========================================`n\" }; " ^
  "Log '================ BLOCO 5: C2 - MOBILENET PRE-TREINADO (CENARIOS 1 A 5) ================'; " ^
  "1..5 | ForEach-Object { $s = $_; Log \"`n========================================\"; Log \" MOBILENET PRE-TREINADO - SETTING $s     \"; Log \"========================================\"; $i = Get-Date; Log ('INICIO: ' + $i.ToString('HH:mm:ss.ff')); python -u main_baselines.py --model mobilenet --pretrained 1 --epoch 5 --width 275 --height 183 --outdir strawberry_out --outfile strawberry_$s --batch 32 -i setting$s-train.txt | Tee-Object -FilePath $logFile -Append; $f = Get-Date; Log ('FIM:    ' + $f.ToString('HH:mm:ss.ff')); Log ('TEMPO TOTAL MOBILENET PRE-TREINADO SETTING ' + $s + ' : ' + [math]::Round(($f - $i).TotalSeconds, 2) + ' segundos'); Log \"========================================`n\" }; " ^
  "Write-Host \"`n✅ Relatorio unico salvo com sucesso em: $logFile\" -ForegroundColor Green"